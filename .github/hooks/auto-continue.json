{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "powershell": "& '.github/hooks/scripts/auto-continue.ps1'",
        "env": {
          "COPILOT_AUTO_CONTINUE_PROMPT": "Please continue improving",
          "COPILOT_AUTO_CONTINUE_LIMIT": "3"
        },
        "timeoutSec": 10
      }
    ]
  }
}